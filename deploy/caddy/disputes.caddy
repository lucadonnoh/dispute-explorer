# Public entrypoint for disputes.slopo.net on eth-node. Install as
# /etc/caddy/conf.d/disputes-public.caddy; the Cloudflare tunnel on the rpi
# (192.168.10.61) forwards the hostname here, and ufw only admits the rpi.
:15103 {
	bind 192.168.10.140
	route {
		@wrong_host not header Host disputes.slopo.net
		respond @wrong_host "Misdirected Request" 421

		@insecure header X-Forwarded-Proto http
		redir @insecure https://disputes.slopo.net{uri} 308

		header {
			-Server
			Strict-Transport-Security "max-age=31536000"
			# Next.js hydrates with inline bootstrap scripts; eval stays forbidden.
			Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; manifest-src 'self'; upgrade-insecure-requests"
			X-Content-Type-Options "nosniff"
			X-Frame-Options "DENY"
			Referrer-Policy "strict-origin-when-cross-origin"
			Permissions-Policy "accelerometer=(), autoplay=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()"
		}

		# The indexer API, same-origin under /api. Only the read-only routes the
		# app uses are exposed, plus Ponder's /status (latest indexed block) for
		# the Uptime Kuma freshness check; /metrics and the rest stay on loopback.
		@api {
			method GET HEAD
			path /api/games /api/games/* /api/stats /api/health /api/ready /api/status
		}
		handle @api {
			uri strip_prefix /api
			reverse_proxy http://127.0.0.1:13101
		}

		@api_path path /api /api/*
		respond @api_path "Not found" 404

		@static {
			method GET HEAD
			path /_next/static/*
		}
		header @static Cache-Control "public, max-age=31536000, immutable"

		reverse_proxy http://127.0.0.1:13100
	}
}
